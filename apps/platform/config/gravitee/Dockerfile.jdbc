ARG GENIO_ONE_GRAVITEE_BASE_IMAGE=graviteeio/apim-gateway@sha256:1e675eec55c3e2ee151fb2e25f57d9443cae1d3b371eb29c2aaf53b9f97dfe94
FROM ${GENIO_ONE_GRAVITEE_BASE_IMAGE}

ARG GENIO_ONE_GRAVITEE_HOME

USER root
RUN mkdir -p "${GENIO_ONE_GRAVITEE_HOME}/plugins/ext/repository-jdbc"
ADD --checksum=sha256:73914527305a40cce504b0d3d90b23caf565136912d607ae8ae7c5895512332c \
  https://repo.maven.apache.org/maven2/org/postgresql/postgresql/42.7.14/postgresql-42.7.14.jar \
  /tmp/postgresql-42.7.14.jar
RUN install -o 1001 -g 1000 -m 0644 \
  /tmp/postgresql-42.7.14.jar \
  "${GENIO_ONE_GRAVITEE_HOME}/plugins/ext/repository-jdbc/postgresql-42.7.14.jar" \
  && rm /tmp/postgresql-42.7.14.jar

# Management API only: retain Gravitee's native in-memory administrator
# provider, but source its credential from the deployment Secret instead of
# shipping the public default admin/admin credential. Gateway images do not
# contain this configuration block, so the conditional is intentionally a no-op.
RUN config="${GENIO_ONE_GRAVITEE_HOME}/config/gravitee.yml"; \
  if grep -q 'password: \$2a\$10\$Ihk05VSds5rUSgMdsMVi9OKMIx2yUvMz7y9VP3rJmQeizZLrhLMyq' "${config}"; then \
    sed -i \
      -e 's/password-encoding-algo: bcrypt/password-encoding-algo: none/' \
      -e 's|password: \$2a\$10\$[^[:space:]]*|password: ${GENIO_ONE_GRAVITEE_ADMIN_PASSWORD}|' \
      "${config}"; \
  fi

USER 1001:1000
