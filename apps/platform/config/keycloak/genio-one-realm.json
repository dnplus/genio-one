      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${genioScope.genioone_invoke}"
      }
    },
    {
      "name": "management:identity:read",
