      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${genioScope.management_identity_write}"
      }
    },
    {
      "name": "management:resources:read",
