# Local-only development defaults. Copy this file to .env.local before starting
# containers. The upstream images below are pinned to immutable digests; locally
# built GenioOne wrapper images use explicit version tags.

GENIO_ONE_POSTGRES_IMAGE=postgres@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
GENIO_ONE_VALKEY_IMAGE=valkey/valkey@sha256:a0dbf4c1d5708782907c10e2c72deff317518518b5288a58416981d9db95d30b
GENIO_ONE_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib@sha256:b3079f45e19bdb7326bf49cdddce6cf60dfd865138db39f2733ea48ab17bc4cb
GENIO_ONE_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:ff4257d0d64efbe99ed1ddfaf07765cc3c36dc7518bf8324d41961327f441c54
GENIO_ONE_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server@sha256:5a94a6cc2005af20844c31aa49906d55c3c48b0e0fb9f29bf0d6c29e52692f3a
GENIO_ONE_GRAVITEE_MANAGEMENT_API_IMAGE=graviteeio/apim-management-api@sha256:134afe31e65dbaaa977f3870682dd5dbac8d0314ac9ecce220c5ea960352a20b
GENIO_ONE_GRAVITEE_GATEWAY_IMAGE=graviteeio/apim-gateway@sha256:26382f7697e5d4a621f4ba21cd60e7dc12d66e05235d725d402318688077bb1e
GENIO_ONE_GRAVITEE_MANAGEMENT_API_JDBC_IMAGE=genio-one/gravitee-management-api:4.9.0-postgresql-42.7.13
GENIO_ONE_GRAVITEE_GATEWAY_JDBC_IMAGE=genio-one/gravitee-gateway:4.9.0-postgresql-42.7.13
GENIO_ONE_API_FIXTURE_IMAGE=nginx@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c

# Local Compose guardrails. Resource health combines active limits, observed
# Kind memory and 4 GiB of development headroom instead of a fixed VM size.
GENIO_ONE_POSTGRES_MEMORY_LIMIT=1g
GENIO_ONE_VALKEY_MEMORY_LIMIT=512m
GENIO_ONE_OTEL_COLLECTOR_MEMORY_LIMIT=256m
GENIO_ONE_OTEL_ANALYTICS_MEMORY_LIMIT=512m
GENIO_ONE_KEYCLOAK_MEMORY_LIMIT=2g
GENIO_ONE_KEYCLOAK_BOOTSTRAP_MEMORY_LIMIT=256m
GENIO_ONE_CLICKHOUSE_MEMORY_LIMIT=2g
GENIO_ONE_GRAVITEE_BOOTSTRAP_MEMORY_LIMIT=256m
GENIO_ONE_GRAVITEE_MANAGEMENT_MEMORY_LIMIT=1536m
GENIO_ONE_GRAVITEE_GATEWAY_MEMORY_LIMIT=1536m
GENIO_ONE_API_FIXTURE_MEMORY_LIMIT=128m

GENIO_ONE_POSTGRES_PORT=55432
GENIO_ONE_POSTGRES_DB=genio_one
GENIO_ONE_POSTGRES_USER=genio_one
GENIO_ONE_POSTGRES_PASSWORD=genio-one-local
GENIO_ONE_DATABASE_URL=postgresql://genio_one:genio-one-local@127.0.0.1:55432/genio_one?sslmode=disable
GENIO_ONE_DATABASE_MAX_CONNECTIONS=16
GENIO_ONE_PLATFORM_API_MODE=postgres
TYPESAFE_API_KEY=
GENIO_ONE_MODEL_ROUTING_DECISION_MODEL=jev-1.13.0
GENIO_ONE_MODEL_ROUTING_DECISION_MIN_CONFIDENCE=0.6
GENIO_ONE_MCP_OAUTH_ENCRYPTION_KEY=CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCws=
GENIO_ONE_PLATFORM_ORIGIN=http://127.0.0.1:58082
GENIO_ONE_MCP_OAUTH_PUBLIC_ORIGIN=http://127.0.0.1:58082
GENIO_ONE_MANAGEMENT_UI_ORIGIN=http://127.0.0.1:5173
GENIO_ONE_MANAGEMENT_CONSOLE_ORIGIN=http://127.0.0.1:5173
GENIO_ONE_CONTROL_PLANE_ADDR=127.0.0.1:58082
GENIO_ONE_CONTROL_PLANE_PUBLIC_ORIGIN=http://127.0.0.1:58082
GENIO_ONE_GATEWAY_SIGNING_PRIVATE_KEY_FILE=.local/gateway-runtime/keys/projection.pem
GENIO_ONE_RUNTIME_COMMAND_SIGNING_PRIVATE_KEY_FILE=.local/gateway-runtime/keys/runtime-command.pem
GENIO_ONE_POLICY_ARTIFACT_SIGNING_PRIVATE_KEY_FILE=.local/gateway-runtime/keys/policy-artifact.pem
GENIO_ONE_RELEASE_ROOT_SIGNING_PRIVATE_KEY_FILE=.local/gateway-runtime/keys/release-root.pem
GENIO_ONE_RUNTIME_HEALTH_TIMEOUT_SECONDS=90

GENIO_ONE_VALKEY_PORT=56379
GENIO_ONE_VALKEY_URL=redis://127.0.0.1:56379
GENIO_ONE_VALKEY_INTERNAL_ORIGIN=redis://host.docker.internal:56379

GENIO_ONE_OTEL_GRPC_PORT=54317
GENIO_ONE_OTEL_HTTP_PORT=54318
GENIO_ONE_OTEL_HEALTH_PORT=53133
GENIO_ONE_OTEL_ANALYTICS_GRPC_PORT=54319
GENIO_ONE_OTEL_ANALYTICS_HTTP_PORT=54320
GENIO_ONE_OTEL_ANALYTICS_HEALTH_PORT=53134

GENIO_ONE_KEYCLOAK_PORT=58080
GENIO_ONE_KEYCLOAK_ADMIN=admin
GENIO_ONE_KEYCLOAK_ADMIN_PASSWORD=admin
GENIO_ONE_KEYCLOAK_POSTGRES_DB=keycloak
GENIO_ONE_KEYCLOAK_POSTGRES_USER=keycloak
GENIO_ONE_KEYCLOAK_POSTGRES_PASSWORD=keycloak-local
GENIO_ONE_KEYCLOAK_BOOTSTRAP_REVISION=keycloak-v2-stable-subject
GENIO_ONE_KEYCLOAK_CONFIG_REVISION=keycloak-v8-local-development-origins
GENIO_ONE_KEYCLOAK_LOGIN_BRAND_NAME=GenioOne
GENIO_ONE_KEYCLOAK_LOGIN_TAGLINE=企業 AI 存取治理控制平面
GENIO_ONE_KEYCLOAK_LOGIN_LOGO_URL=
GENIO_ONE_KEYCLOAK_LOGIN_PRIMARY_COLOR="#425fea"
GENIO_ONE_KEYCLOAK_LOGIN_PAGE_COLOR="#f7f8fa"
GENIO_ONE_KEYCLOAK_LOGIN_CUSTOM_CSS=
GENIO_ONE_KEYCLOAK_LOGIN_BRANDING_ENDPOINT=http://127.0.0.1:5173/v1/identity/login-branding
GENIO_ONE_IDENTITY_MODE=local-dev
GENIO_ONE_KEYCLOAK_ORIGIN=http://127.0.0.1:58080
GENIO_ONE_KEYCLOAK_ISSUER_ORIGIN=http://127.0.0.1:58080
GENIO_ONE_MCP_PUBLIC_ORIGIN=http://127.0.0.1:58190
GENIO_ONE_AI_GATEWAY_DOWNSTREAM_CREDENTIALS_JSON={"schema_version":1,"credentials":[{"tenant_id":"tenant-keycloak-local","connection_id":"connection-repository","provider_kind":"OAUTH","generation":1,"bearer_token":"replace-me"},{"tenant_id":"tenant-keycloak-local","connection_id":"connection-issues","provider_kind":"OAUTH","generation":1,"bearer_token":"replace-me"}]}
# Optional local Gemini fixture. Provide slot-to-key JSON through a secret
# manager or process environment; never commit a real key here.
GENIO_ONE_GEMINI_API_KEYS_JSON=
GENIO_ONE_KEYCLOAK_REALM=genio-one
# `pnpm dev` creates an ignored local Ed25519 runtime-report key pair and
# passes its private half only to Bot and public half only to Platform API.
# Do not place PEM material in this tracked example environment.
GENIO_ONE_SELF_SERVICE_ORIGIN=http://127.0.0.1:5173
GENIO_ONE_BOT_ORIGIN=http://127.0.0.1:5180
# Platform API seeds the canonical Genio Bot Resource and Connection through
# this local Bot service endpoint during durable bootstrap.
GENIO_BOT_SERVICE_ENDPOINT=http://127.0.0.1:5181
GENIO_ONE_SELF_SERVICE_OIDC_CLIENT_ID=genio-one-self-service
GENIO_ONE_MANAGEMENT_OIDC_CLIENT_ID=genio-one-management-console
GENIO_ONE_MANAGEMENT_AGENT_REDIRECT_URI=http://127.0.0.1:8765/callback
GENIO_ONE_KEYCLOAK_AUDIENCE=genio-one-product-api
GENIO_ONE_KEYCLOAK_CLIENT_ID=genio-one-product-api
GENIO_ONE_KEYCLOAK_CLIENT_SECRET=genio-one-local-client-secret
GENIO_ONE_KEYCLOAK_REQUIRED_SCOPE=genioone-management
GENIO_ONE_KEYCLOAK_TEST_USERNAME=admin
GENIO_ONE_KEYCLOAK_TEST_PASSWORD=admin
GENIO_ONE_KEYCLOAK_TEST_SUBJECT_ID=49601374-7901-4e9d-bc9e-ed1e2536f51e
GENIO_ONE_TENANT_BOOTSTRAP_REVISION=tenant-identity-v1
GENIO_ONE_BOOTSTRAP_TENANT_ID=tenant-keycloak-local
GENIO_ONE_BOOTSTRAP_ADMIN_SUBJECT_ID=person-platform-admin
GENIO_ONE_BOOTSTRAP_ADMIN_EXTERNAL_SUBJECT_ID=49601374-7901-4e9d-bc9e-ed1e2536f51e
GENIO_ONE_BOOTSTRAP_ADMIN_DISPLAY_NAME='Local Platform Admin'
GENIO_ONE_BOOTSTRAP_ADMIN_EMAIL=admin@genioone.invalid
GENIO_ONE_BOOTSTRAP_ADMIN_USERNAME=admin
GENIO_ONE_BOOTSTRAP_ADMIN_PASSWORD=admin
# For multiple bootstrap subjects, set GENIO_ONE_BOOTSTRAP_SUBJECTS_JSON to an
# array of {tenant_id, subject_id, kind, role, external_identities}; when set,
# it is the sole authoritative bootstrap source.
# Comma-separated provider ids whose first sign-in may register a Person.
# Brokered ids are "<identity_provider_id>:<keycloak alias>", for example
# "keycloak:entra-id". Empty means every Person is provisioned explicitly.
# A provisioned Person gets no Organization membership; grant access after.
GENIO_ONE_IDENTITY_JIT_PROVIDER_IDS=
GENIO_ONE_KEYCLOAK_GATEWAY_RUNTIME_SCOPE=genioone-gateway-runtime
GENIO_ONE_KEYCLOAK_CODEX_CLIENT_ID=codex
GENIO_ONE_KEYCLOAK_CODEX_CLIENT_SECRET=genio-one-codex-local-secret
GENIO_ONE_KEYCLOAK_GROK_CLIENT_ID=grok
GENIO_ONE_KEYCLOAK_GROK_CLIENT_SECRET=genio-one-grok-local-secret
GENIO_ONE_KEYCLOAK_CODEX_MCP_CLIENT_ID=codex-mcp
GENIO_ONE_KEYCLOAK_GROK_MCP_CLIENT_ID=grok-mcp

GENIO_ONE_CLICKHOUSE_HTTP_PORT=58123
GENIO_ONE_CLICKHOUSE_NATIVE_PORT=59000
GENIO_ONE_CLICKHOUSE_DB=genio_one_analytics
GENIO_ONE_CLICKHOUSE_USER=genio_one
GENIO_ONE_CLICKHOUSE_PASSWORD=genio-one-local

GENIO_ONE_GRAVITEE_MANAGEMENT_API_PORT=58083
GENIO_ONE_GRAVITEE_MANAGEMENT_API_ORIGIN=http://127.0.0.1:58083
GENIO_ONE_GRAVITEE_MANAGEMENT_API_INTERNAL_ORIGIN=http://host.docker.internal:58083
GENIO_ONE_GRAVITEE_GATEWAY_PORT=58084
# Compose validation uses Gravitee's generated self-signed server certificate.
# Customer Helm installs must provide a trusted TLS secret and leave insecure verification off.
GENIO_ONE_GRAVITEE_GATEWAY_SCHEME=https
GENIO_ONE_GRAVITEE_GATEWAY_TLS_INSECURE=true
GENIO_ONE_GRAVITEE_POSTGRES_DB=gravitee
GENIO_ONE_GRAVITEE_POSTGRES_USER=gravitee
GENIO_ONE_GRAVITEE_POSTGRES_PASSWORD=gravitee-local
GENIO_ONE_API_FIXTURE_PORT=58085
GENIO_ONE_GRAVITEE_ADMIN_USERNAME=admin
GENIO_ONE_GRAVITEE_ADMIN_PASSWORD=admin
GENIO_ONE_GRAVITEE_ORGANIZATION=DEFAULT
GENIO_ONE_GRAVITEE_ENVIRONMENT=DEFAULT
GENIO_ONE_GRAVITEE_API_CROSS_ID=genio-one-traditional-api
GENIO_ONE_GRAVITEE_API_NAME='GenioOne Traditional API'
GENIO_ONE_GRAVITEE_API_CONTEXT_PATH=/genio-one-api
GENIO_ONE_GRAVITEE_API_UPSTREAM_URL=http://api-fixture:8080

# Canonical production-foundation deployment selections.
GENIO_ONE_DEPLOYMENT_DEPLOYABLES=genio-one-platform,genio-gateway
GENIO_ONE_DEPLOYMENT_CAPABILITIES=identity,api-management,analytics

# Required only when the optional ai-mcp-gateway capability is selected.
# The installer uses the native Kubernetes API through kubectl/Helm; Gateway
# Runtime uses its projected service-account token after deployment.
GENIO_ONE_AI_GATEWAY_KUBECONFIG=../../target/genio-one-gateway-validation/kubeconfig
GENIO_ONE_AI_GATEWAY_NAMESPACE=genio-one-system
GENIO_ONE_AI_GATEWAY_TIMEOUT=5m
GENIO_ONE_AI_GATEWAY_WORKLOAD_MODE=install
GENIO_ONE_GATEWAY_IMAGE=genio-one-gateway:0.1.0-dev.3
GENIO_ONE_GATEWAY_IMAGE_PULL_POLICY=IfNotPresent
GENIO_ONE_AI_GATEWAY_CREDENTIALS_REVISION=local-v1
GENIO_ONE_AI_GATEWAY_AUTHORIZATION_RECEIPT_KEY=genio-one-local-authorization-receipt-key-v1
GENIO_ONE_GATEWAY_TENANT_ID=tenant-keycloak-local
GENIO_ONE_GATEWAY_RUNTIME_IDS=genio-one-gateway-runtime-0,genio-one-gateway-runtime-1
GENIO_ONE_GATEWAY_ID=genio-ai-mcp-gateway
GENIO_ONE_GATEWAY_DISPLAY_NAME='Local Genio Gateway'
GENIO_ONE_GATEWAY_SITE_ID=local-site
GENIO_ONE_GATEWAY_REGION=local
# Created with mode 0600 by post-install. It is installation state, never an
# input secret and never copied into deployment evidence or the post-install journal.
GENIO_ONE_GATEWAY_BOOTSTRAP_FILE=../../target/genio-one/deployment/gateway-bootstrap.json
