{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genio.one/schema/hermes-user-missions-v1.json",
  "title": "GenioOne Hermes blind user missions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "release", "source_classification", "spec_bundle_id", "missions"],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "genio-one" },
    "release": { "type": "string", "minLength": 1 },
    "source_classification": { "enum": ["current", "historical"] },
    "spec_bundle_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mission_id", "role", "surface", "story", "title", "preconditions", "actions", "observable_outcomes"],
        "properties": {
          "mission_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "story": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "preconditions": { "$ref": "#/$defs/textList" },
          "actions": { "$ref": "#/$defs/textList" },
          "observable_outcomes": { "$ref": "#/$defs/textList" }
        }
      }
    }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
