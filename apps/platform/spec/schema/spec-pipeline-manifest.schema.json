{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genio.one/schema/spec-pipeline-manifest-v1.json",
  "title": "GenioOne external review pipeline manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "task_id",
    "release",
    "task_summary",
    "required_artifacts",
    "existing_artifacts",
    "sources",
    "checks",
    "hermes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "genio-one" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "release": { "type": "string", "minLength": 1 },
    "task_summary": { "type": "string", "minLength": 1 },
    "grok_timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 900 },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["normalized_bdd", "adr"] }
    },
    "existing_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "artifact_id", "source_id"],
        "properties": {
          "kind": { "enum": ["normalized_bdd", "adr"] },
          "artifact_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notion_pages", "notion_data_sources", "local_files"],
      "properties": {
        "notion_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "page_id", "locator"],
            "properties": {
              "source_id": { "$ref": "#/$defs/sourceId" },
              "page_id": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 },
              "start_heading": { "type": "string", "minLength": 1 },
              "end_heading": { "type": "string", "minLength": 1 }
            }
          }
        },
        "notion_data_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "data_source_id", "locator"],
            "properties": {
              "source_id": { "$ref": "#/$defs/sourceId" },
              "data_source_id": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 },
              "property_names": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "local_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "kind", "path", "locator"],
            "properties": {
              "source_id": { "$ref": "#/$defs/sourceId" },
              "kind": { "enum": ["task", "adr", "architecture", "policy", "acceptance"] },
              "path": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "command"],
        "properties": {
          "check_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 }
        }
      }
    },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "entry_path",
        "oidc_discovery_url",
        "tenant",
        "credential_file",
        "username_key",
        "password_key",
        "fixture",
        "run_budget_seconds"
      ],
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "entry_path": { "type": "string", "minLength": 1 },
        "oidc_discovery_url": { "type": "string", "format": "uri" },
        "tenant": { "type": "string", "minLength": 1 },
        "credential_file": { "type": "string", "minLength": 1 },
        "username_key": { "type": "string", "minLength": 1 },
        "password_key": { "type": "string", "minLength": 1 },
        "mission_id": { "type": "string", "minLength": 1 },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "capability"],
          "properties": {
            "resource": { "type": "string", "minLength": 1 },
            "capability": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 }
          }
        },
        "run_budget_seconds": { "type": "integer", "minimum": 30, "maximum": 900 }
      }
    }
  },
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}
