# Runtime mode: "local" (protocol development, no exec) or "e2b-self-hosted"
GENIO_BOT_RUNTIME=local
# Optional GenioOne Gateway adapter. One Policy selects the Bot route; these
# values only describe an available adapter.
# GENIO_ONE_MODEL_GATEWAY_BASE_URL=http://127.0.0.1:58084/v1
# GENIO_BOT_GENIO_GATEWAY_MODELS_JSON='[{"publicModelId":"genio-standard","displayName":"Genio Standard"}]'
GENIO_BOT_CODEX_COMMAND=codex
GENIO_BOT_CODEX_VERSION=
GENIO_BOT_CODEX_HOME=.local/codex-home
GENIO_BOT_REGISTRY_DB=.local/bot-registry.sqlite
GENIO_BOT_PACKAGE_STORE=.local/bot-packages
GENIO_BOT_ARTIFACT_STORE=.local/artifacts
# Optional JSON array of validated BotPackageManifest records for a tenant fixture.
# GENIO_BOT_PACKAGE_CATALOG=fixtures/corp-service-desk-bot/catalog.json
# Production cross-owner Bot execution requires the CP server-only exchange.
# GENIO_ONE_AGENT_TOKEN_EXCHANGE_URL=http://127.0.0.1:58082/v1/agent-runtime/token
# GENIO_ONE_AGENT_TOKEN_EXCHANGE_TOKEN=
# GENIO_ONE_AGENT_SUBJECT_SERVICE_TOKEN=
# Working directory for child process execution (defaults to system tmpdir, e.g. /tmp on Linux)
GENIO_BOT_SERVER_CWD=/tmp
GENIO_BOT_LOCAL_CWD=/tmp
GENIO_BOT_PORT=5181

# Self-hosted E2B settings (required only when GENIO_BOT_RUNTIME=e2b-self-hosted)
E2B_DOMAIN=e2b.internal.example
E2B_API_URL=https://api.e2b.internal.example
E2B_SANDBOX_URL=https://sandbox.e2b.internal.example
E2B_API_KEY=
GENIO_BOT_E2B_REQUEST_TIMEOUT_MS=120000
GENIO_BOT_E2B_DESKTOP_BASE_TEMPLATE=desktop-self-hosted
GENIO_BOT_E2B_TEMPLATE=genio-bot-desktop
GENIO_BOT_E2B_DESKTOP_TEMPLATE=genio-bot-desktop
GENIO_BOT_E2B_HEADLESS_TEMPLATE=genio-bot-headless
GENIO_BOT_E2B_HEADLESS_CPU_COUNT=2
GENIO_BOT_E2B_HEADLESS_MEMORY_MB=2048

# GenioOne connection
GENIO_ONE_PLATFORM_ORIGIN=http://127.0.0.1:58082
GENIO_ONE_MCP_URL=http://one.localhost:1975/mcp
# GENIO_ONE_MCP_RELAY_ORIGIN=http://127.0.0.1:5181
GENIO_ONE_LOCAL_MCP_FIXTURE_PORT=19103
VITE_GENIO_ONE_BOT_OIDC_CLIENT_ID=genio-one-bot
# Must match genio-one-bot client — do not use self-service browser-configuration.scopes alone.
# VITE_GENIO_ONE_BOT_OIDC_SCOPES=openid genioone-invocation genioone-management
VITE_GENIO_ONE_PLATFORM_ORIGIN=http://127.0.0.1:58082

GENIO_ONE_OTEL_COLLECTOR_ORIGIN=http://127.0.0.1:54318
