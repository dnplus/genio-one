{
  "name": "genio-one-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Genio Bot rich client for codex-rs app-server on E2B Desktop.",
  "license": "Apache-2.0",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --env-file=.env.local --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5180",
    "build": "bun run generate:codex-protocol && vite build && bun build server/index.ts --target=bun --outdir=dist/server",
    "build:e2b-template": "bun scripts/build-e2b-template.ts",
    "prepare:local-one-mcp": "bun scripts/prepare-local-one-mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./server",
    "test:local-hands": "cargo build -p genio-one-endpoint --bin genio-endpoint-hands && bun test tests/local-hands/native.test.ts",
    "test:e2b:desktop": "bun server/e2b-desktop-live.ts",
    "test:e2b:live": "bun server/e2b-runtime-live.ts",
    "test:runtime-bridge:live": "bun scripts/runtime-bridge-live.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "start": "bun dist/server/index.js",
    "generate:codex-protocol": "codex app-server generate-ts --experimental --out server/generated",
    "test:voice-ui": "playwright test --config tests/voice-input/playwright.config.ts"
  },
  "dependencies": {
    "@e2b/desktop": "2.4.0",
    "@fastify/static": "10.1.4",
    "@fastify/websocket": "11.3.0",
    "@genioone/protocol": "workspace:*",
    "@genioone/telemetry": "workspace:*",
    "e2b": "2.50.0",
    "fastify": "5.12.5",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@openai/codex": "0.155.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
