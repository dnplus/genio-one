{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "*.ts",
    "servicenow-csm/**/*.ts",
    "mail2000/**/*.ts",
    "archify/**/*.ts",
    "discovery/**/*.ts"
  ]
}
